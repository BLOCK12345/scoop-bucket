{
    "version": "26.11.99",
    "description": "FluentCleaner is the transparent, community-powered CCleaner alternative for Windows.",
    "homepage": "https://github.com/builtbybel/FluentCleaner",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/builtbybel/FluentCleaner/releases/download/26.11.99/FluentCleaner-Classic-net48.zip",
            "hash": "f76824cb0b72cc50ed837e8f803c2677a0068949b079b296c07bff6c07b68948",
            "extract_dir": "FluentCleaner-Classic-net48"
        }
    },
    "pre_install": [
        "if (-not (Test-Path \"$persist_dir\\settings.json\")) {",
        "    if (Test-Path \"$env:APPDATA\\FluentCleaner\") {",
        "        info \"Copying old '$env:APPDATA\\FluentCleaner' to '$persist_dir\"",
        "        Copy-Item \"$env:APPDATA\\FluentCleaner\\*\" \"$dir\" -Exclude 'LOCK' -Recurse -Force",
        "    }",
        "    if (-not (Test-Path \"$dir\\settings.json\")) { New-Item -Path \"$dir\\settings.json\" -ItemType File -Force | Out-Null }",
        "}"
    ],
    "bin": [
        "FluentCleaner.Classic.exe",
        [
            "FluentCleaner.Classic.exe",
            "fluentcleaner"
        ]
    ],
    "shortcuts": [
        [
            "FluentCleaner.Classic.exe",
            "FluentCleaner Classic"
        ]
    ],
    "persist": [
        "Custom",
        "settings.json"
    ],
    "checkver": {
        "github": "https://github.com/builtbybel/FluentCleaner"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/builtbybel/FluentCleaner/releases/download/$version/FluentCleaner-Classic-net48.zip"
            }
        }
    }
}
